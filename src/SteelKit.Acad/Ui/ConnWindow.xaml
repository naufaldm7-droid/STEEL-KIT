<Window x:Class="SteelKit.Acad.Ui.ConnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SteelKit.Acad.Ui"
        Title="Steel Kit - Sambungan" Width="1360" Height="860" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen" FontFamily="{DynamicResource SkFont}" Foreground="{DynamicResource SkText}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="/SteelKit;component/Ui/Theme.xaml"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root">
        <Grid Margin="18,0,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource SkLogo}" Width="26" Height="26"/>
                    <TextBlock Text="STEEL KIT" FontFamily="{StaticResource SkFontDisplay}" FontWeight="Bold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="#33FFFFFF" Margin="12,0"/>
                    <TextBlock Text="Sambungan" FontSize="14" Foreground="{StaticResource SkText2}" VerticalAlignment="Center"/>
                    <Border x:Name="ContextBadge" CornerRadius="8" Background="#1F38BDF8" BorderBrush="#5538BDF8" BorderThickness="1" Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="ContextText" FontSize="11" Foreground="#9BDCFB" MaxWidth="700" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,-10,0">
                    <Button Style="{StaticResource SkWinBtn}" Content="&#xE921;" Click="OnMin" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource SkWinBtn}" Content="&#xE922;" Click="OnMax" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource SkWinBtn}" Content="&#xE8BB;" Click="OnCancel" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- galeri -->
                <Border Style="{StaticResource SkCard}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="GalleryTitle" Text="JENIS SAMBUNGAN" Style="{StaticResource SkLabel}" FontSize="10"/>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <TextBox x:Name="Search" Style="{StaticResource SkField}" Padding="28,0,8,0" TextChanged="OnSearch"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource SkIcons}" FontSize="12" Foreground="{StaticResource SkText3}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchHint" Text="Cari, mis. angkur, truss, gording" FontSize="12" Foreground="{StaticResource SkText3}" Margin="29,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <ListBox x:Name="Gallery" Grid.Row="2" Style="{StaticResource SkList}" SelectionChanged="OnGallery"
                                 VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border CornerRadius="6" ClipToBounds="True" BorderBrush="#22FFFFFF" BorderThickness="1">
                                            <Image Source="{Binding Thumb}" Width="94" Height="70" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12.5"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- pratinjau + kapan dipakai + cek -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource SkCard}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Margin="16,12,16,8">
                                <TextBlock x:Name="ConnTitle" FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource SkFontDisplay}"/>
                                <TextBlock x:Name="ConnSummary" FontSize="11.5" Foreground="{StaticResource SkText2}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Row="1" x:Name="PreviewHost" Margin="10,0,10,10" CornerRadius="8" ClipToBounds="True" Background="#1B222C" SizeChanged="OnPreviewSize">
                                <Image x:Name="Preview" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Height="196">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SkCard}" Padding="14,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="KAPAN DIPAKAI (PRAKTIK UMUM)" Style="{StaticResource SkLabel}" FontSize="10"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="Recommend" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource SkText2}" LineHeight="18"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SkCard}" Padding="14,12">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top">
                                    <TextBlock Text="CEK JARAK &amp; UKURAN MINIMUM" Style="{StaticResource SkLabel}" FontSize="10"/>
                                    <TextBlock x:Name="CheckCount" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource SkText2}"/>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="Checks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource SkIcons}" FontSize="11" Foreground="{Binding Brush}" Margin="0,2,0,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Item}" FontSize="12" TextWrapping="Wrap" Foreground="{Binding TextBrush}"/>
                                                        <TextBlock Text="{Binding Rule}" FontSize="10.5" Foreground="{StaticResource SkText3}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- parameter -->
                <Border Grid.Column="4" Style="{StaticResource SkCard}" Padding="14,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="PARAMETER" Style="{StaticResource SkLabel}" FontSize="10"/>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource SkGhost}" Margin="0,10,0,0" Click="OnRecommend">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource SkIcons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Isi ulang dimensi rekomendasi"/>
                            </StackPanel>
                        </Button>
                        <ui:PropertyPanel x:Name="Props"/>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SkText3}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                           Text="Cek di atas hanya aturan jarak/ukuran minimum (praktik umum), bukan cek kekuatan. Kapasitas sambungan tetap dihitung dan disahkan engineer struktur."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SkGhost}" Content="Batal" Click="OnCancel" MinWidth="90" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource SkGhost}" Content="Detail 2D saja" Click="OnDetail" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource SkGhost}" Content="Buat / perbarui 3D" Click="OnMake" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource SkPrimary}" Click="OnBoth" MinWidth="190">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FB;" FontFamily="{StaticResource SkIcons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Buat 3D + detail 2D"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
