<!-- Tema Steel Kit: gelap selaras AutoCAD, kartu kaca, aksen sian -> nila, huruf Segoe UI Variable. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="SkFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SkFontDisplay">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="SkIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Color x:Key="SkC1">#38BDF8</Color>
    <Color x:Key="SkC2">#6366F1</Color>
    <SolidColorBrush x:Key="SkText" Color="#E8EEF5"/>
    <SolidColorBrush x:Key="SkText2" Color="#9FB0C2"/>
    <SolidColorBrush x:Key="SkText3" Color="#6B7B8E"/>
    <SolidColorBrush x:Key="SkAccent" Color="#38BDF8"/>
    <SolidColorBrush x:Key="SkWarn" Color="#FB923C"/>
    <SolidColorBrush x:Key="SkGlass" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="SkGlassHi" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="SkGlassBorder" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="SkInput" Color="#66101620"/>
    <LinearGradientBrush x:Key="SkGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0"/>
        <GradientStop Color="#6366F1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SkGradHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#67CFFA" Offset="0"/>
        <GradientStop Color="#8183F4" Offset="1"/>
    </LinearGradientBrush>
    <!-- latar bila efek akrilik Windows 11 tidak tersedia -->
    <LinearGradientBrush x:Key="SkWindowSolid" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A2029" Offset="0"/>
        <GradientStop Color="#202838" Offset="0.6"/>
        <GradientStop Color="#1B2230" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SkWindowGlass" Color="#B8161B24"/>

    <!-- logo: kepala baut segi enam + penampang WF (sama dengan tools/gen_logo.py) -->
    <DrawingImage x:Key="SkLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M100,50 L75,90.7 L25,90.7 L0,50 L25,9.3 L75,9.3 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#38BDF8" Offset="0"/>
                            <GradientStop Color="#6366F1" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#550F172A" Thickness="1.6"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#3AFFFFFF" Geometry="M100,50 L0,50 L25,9.3 L75,9.3 Z"/>
                <GeometryDrawing Brush="#66101828" Geometry="M29.2,26.6 L73.2,26.6 L73.2,35.6 L55.7,35.6 L55.7,67.6 L73.2,67.6 L73.2,76.6 L29.2,76.6 L29.2,67.6 L46.7,67.6 L46.7,35.6 L29.2,35.6 Z"/>
                <GeometryDrawing Brush="White" Geometry="M28,25 L72,25 L72,34 L54.5,34 L54.5,66 L72,66 L72,75 L28,75 L28,66 L45.5,66 L45.5,34 L28,34 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- kartu kaca -->
    <Style x:Key="SkCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SkGlass}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SkGlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="SkLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SkFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource SkText2}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- tombol utama bergradasi -->
    <Style x:Key="SkPrimary" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource SkFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" CornerRadius="9" Background="{StaticResource SkGrad}">
                            <Border.Effect><DropShadowEffect Color="#6366F1" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
                        </Border>
                        <Border CornerRadius="9,9,0,0" Height="14" VerticalAlignment="Top" Background="#22FFFFFF" Margin="1,1,1,0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{StaticResource SkGradHover}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- tombol kaca -->
    <Style x:Key="SkGhost" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SkText}"/>
        <Setter Property="FontFamily" Value="{StaticResource SkFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="9" Background="{StaticResource SkGlass}" BorderBrush="{StaticResource SkGlassBorder}" BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{StaticResource SkGlassHi}"/><Setter TargetName="bg" Property="BorderBrush" Value="#5538BDF8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- chip contoh kalimat -->
    <Style x:Key="SkChip" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SkText2}"/>
        <Setter Property="FontFamily" Value="{StaticResource SkFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="13" Padding="11,4" Background="#0FFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="#8838BDF8"/><Setter Property="Foreground" Value="{StaticResource SkText}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- tombol jendela (min / maks / tutup) -->
    <Style x:Key="SkWinBtn" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="{StaticResource SkText2}"/>
        <Setter Property="FontFamily" Value="{StaticResource SkIcons}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/><Setter Property="Foreground" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- kotak teks gelap -->
    <Style x:Key="SkTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource SkText}"/>
        <Setter Property="CaretBrush" Value="{StaticResource SkAccent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource SkAccent}"/>
        <Setter Property="FontFamily" Value="{StaticResource SkFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="10" Background="{StaticResource SkInput}" BorderBrush="{StaticResource SkGlassBorder}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#AA38BDF8"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- sakelar -->
    <Style x:Key="SkSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource SkText}"/>
        <Setter Property="FontFamily" Value="{StaticResource SkFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="40" Height="22" VerticalAlignment="Center">
                            <Border x:Name="track" CornerRadius="11" Background="#33FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"/>
                            <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource SkGrad}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- kotak centang kecil untuk tabel -->
    <Style x:Key="SkCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="b" Width="16" Height="16" CornerRadius="4" Background="#22FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="t" Text="&#xE73E;" FontFamily="{StaticResource SkIcons}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource SkGrad}"/><Setter TargetName="b" Property="BorderBrush" Value="Transparent"/><Setter TargetName="t" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- bilah gulir tipis -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="#44FFFFFF" Margin="1"/></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="#44FFFFFF" Margin="1"/></ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- tabel gelap -->
    <Style x:Key="SkGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="#08FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource SkText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="28"/>
        <Setter Property="FontFamily" Value="{StaticResource SkFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource SkText2}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="Padding" Value="5,6"/>
                    <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="5,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3338BDF8"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SkGridEdit" TargetType="TextBox">
        <Setter Property="Background" Value="#33101620"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CaretBrush" Value="{StaticResource SkAccent}"/>
        <Setter Property="BorderBrush" Value="#AA38BDF8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2,0"/>
    </Style>

    <Style x:Key="SkProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border CornerRadius="3" Background="#22FFFFFF"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator" CornerRadius="3" Background="{StaticResource SkGrad}" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ====================== kontrol tambahan (dipakai semua jendela) ====================== -->

    <!-- kotak isian kecil -->
    <Style x:Key="SkField" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource SkText}"/>
        <Setter Property="CaretBrush" Value="{StaticResource SkAccent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource SkAccent}"/>
        <Setter Property="FontFamily" Value="{StaticResource SkFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="7" Background="{StaticResource SkInput}" BorderBrush="{StaticResource SkGlassBorder}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#AA38BDF8"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#5538BDF8"/></Trigger>
                        <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="bd" Property="Background" Value="#0AFFFFFF"/><Setter Property="Foreground" Value="{StaticResource SkText2}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- tombol ikon kecil (toolbar) -->
    <Style x:Key="SkIconBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SkText2}"/>
        <Setter Property="FontFamily" Value="{StaticResource SkIcons}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="7" Background="{StaticResource SkGlass}" BorderBrush="{StaticResource SkGlassBorder}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{StaticResource SkGlassHi}"/><Setter Property="Foreground" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- isi menurun -->
    <Style x:Key="SkComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource SkText}"/>
        <Setter Property="FontFamily" Value="{StaticResource SkFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Padding="10,5" CornerRadius="6" Margin="3,1" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#3338BDF8"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SkCombo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource SkText}"/>
        <Setter Property="FontFamily" Value="{StaticResource SkFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SkComboItem}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="tg" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="b" CornerRadius="7" Background="{StaticResource SkInput}" BorderBrush="{StaticResource SkGlassBorder}" BorderThickness="1">
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource SkIcons}" FontSize="9" Foreground="{StaticResource SkText2}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#5538BDF8"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#AA38BDF8"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="content" IsHitTestVisible="False" Margin="10,0,26,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="9,0,26,0" VerticalAlignment="Center"
                                 Foreground="{TemplateBinding Foreground}" CaretBrush="{StaticResource SkAccent}" SelectionBrush="{StaticResource SkAccent}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" Background="Transparent">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="#F71C232D" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="0,4">
                                <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="content" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- daftar -->
    <Style x:Key="SkListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource SkText}"/>
        <Setter Property="FontFamily" Value="{StaticResource SkFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Padding="10,6" CornerRadius="7" Margin="0,1" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#14FFFFFF"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#2A38BDF8"/><Setter TargetName="b" Property="BorderBrush" Value="#6638BDF8"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SkList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource SkText}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SkListItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
    </Style>

    <!-- pohon -->
    <Style x:Key="SkTreeItem" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource SkText}"/>
        <Setter Property="FontFamily" Value="{StaticResource SkFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="hd" CornerRadius="6" Padding="2,4,8,4" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ToggleButton x:Name="ex" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <TextBlock x:Name="g" Text="&#xE76C;" FontFamily="{StaticResource SkIcons}" FontSize="9" Foreground="{StaticResource SkText2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="g" Property="Text" Value="&#xE70D;"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"/>
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="items" Margin="14,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="items" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="HasItems" Value="False"><Setter TargetName="ex" Property="Visibility" Value="Hidden"/></Trigger>
                        <Trigger SourceName="hd" Property="IsMouseOver" Value="True"><Setter TargetName="hd" Property="Background" Value="#14FFFFFF"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="hd" Property="Background" Value="#2E38BDF8"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SkTree" TargetType="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SkTreeItem}"/>
    </Style>

    <!-- menu konteks -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#F71C232D" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="200">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource SkText}"/>
        <Setter Property="FontFamily" Value="{StaticResource SkFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" CornerRadius="6" Padding="10,6" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="chk" Text="&#xE73E;" FontFamily="{StaticResource SkIcons}" FontSize="11" Foreground="{StaticResource SkAccent}" Width="20" VerticalAlignment="Center" Visibility="Hidden"/>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="chk" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- tooltip -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#F71C232D" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="7" Padding="10,6" MaxWidth="380">
                        <ContentPresenter TextBlock.Foreground="#E8EEF5" TextBlock.FontFamily="Segoe UI Variable Text, Segoe UI" TextBlock.FontSize="12">
                            <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
