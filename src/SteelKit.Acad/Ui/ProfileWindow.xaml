<Window x:Class="SteelKit.Acad.Ui.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SteelKit.Acad.Ui"
        Title="Steel Kit - Pustaka Profil" Width="1240" Height="800" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen" FontFamily="{DynamicResource SkFont}" Foreground="{DynamicResource SkText}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="/SteelKit;component/Ui/Theme.xaml"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root">
        <Grid Margin="18,0,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource SkLogo}" Width="26" Height="26"/>
                    <TextBlock Text="STEEL KIT" FontFamily="{StaticResource SkFontDisplay}" FontWeight="Bold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="#33FFFFFF" Margin="12,0"/>
                    <TextBlock Text="Pustaka Profil" FontSize="14" Foreground="{StaticResource SkText2}" VerticalAlignment="Center"/>
                    <Border CornerRadius="8" Background="#1F38BDF8" BorderBrush="#5538BDF8" BorderThickness="1" Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountBadge" FontSize="11" Foreground="#9BDCFB"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,-10,0">
                    <Button Style="{StaticResource SkWinBtn}" Content="&#xE921;" Click="OnMin" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource SkWinBtn}" Content="&#xE922;" Click="OnMax" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource SkWinBtn}" Content="&#xE8BB;" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- jenis + ukuran -->
                <Border Style="{StaticResource SkCard}" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="JENIS PROFIL" Style="{StaticResource SkLabel}" FontSize="10"/>
                        <ComboBox DockPanel.Dock="Top" x:Name="Families" Style="{StaticResource SkCombo}" Margin="0,0,0,10" SelectionChanged="OnFamily"/>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox x:Name="Search" Style="{StaticResource SkField}" Padding="28,0,8,0" TextChanged="OnSearch"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource SkIcons}" FontSize="12" Foreground="{StaticResource SkText3}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchHint" Text="Cari ukuran, mis. 300x150" FontSize="12" Foreground="{StaticResource SkText3}" Margin="29,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <ListBox x:Name="Sizes" Style="{StaticResource SkList}" SelectionChanged="OnSize" MouseDoubleClick="OnSizeDouble"
                                 VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text="{Binding Kg}" HorizontalAlignment="Right" Foreground="#6B7B8E" FontSize="11.5"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- pratinjau penampang -->
                <Border Grid.Column="2" Style="{StaticResource SkCard}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="16,12,16,0">
                            <TextBlock x:Name="ProfName" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource SkFontDisplay}"/>
                            <TextBlock x:Name="ProfKg" HorizontalAlignment="Right" FontSize="15" Foreground="{StaticResource SkAccent}" VerticalAlignment="Center"/>
                        </Grid>
                        <ui:SectionView x:Name="Section" Grid.Row="1" Margin="8"/>
                        <Border Grid.Row="2" Margin="12,0,12,12" CornerRadius="9" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="PEMAKAIAN UMUM" Style="{StaticResource SkLabel}" FontSize="10" Margin="0,0,0,3"/>
                                <TextBlock x:Name="Usage" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource SkText2}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- dimensi + properti -->
                <Border Grid.Column="4" Style="{StaticResource SkCard}" Padding="14,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="DIMENSI (MM) - BISA DIUBAH" Style="{StaticResource SkLabel}" FontSize="10"/>
                        <ItemsControl DockPanel.Dock="Top" x:Name="Dims"/>
                        <Grid DockPanel.Dock="Top" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Nama" VerticalAlignment="Center" FontSize="12.5"/>
                            <TextBox Grid.Column="1" x:Name="NameBox" Style="{StaticResource SkField}" TextChanged="OnName"/>
                            <CheckBox Grid.Column="2" x:Name="AutoName" Style="{StaticResource SkSwitch}" Content="otomatis" FontSize="12" Margin="10,0,0,0" Click="OnAutoName"/>
                        </Grid>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,12">
                            <Button x:Name="SaveBtn" Style="{StaticResource SkGhost}" Content="Simpan ke katalog saya" Padding="12,6" FontSize="12" Click="OnSave"/>
                            <Button x:Name="DeleteBtn" Style="{StaticResource SkGhost}" Content="Hapus dari katalog saya" Padding="12,6" FontSize="12" Margin="8,0,0,0" Click="OnDelete"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="PROPERTI PENAMPANG" Style="{StaticResource SkLabel}" FontSize="10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PropsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [0]}" FontSize="12" Foreground="#9FB0C2" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding [1]}" FontSize="12" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="{Binding [2]}" FontSize="11" Foreground="#6B7B8E" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- opsi + aksi -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Acuan" VerticalAlignment="Center" Foreground="{StaticResource SkText2}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="AnchorBox" Style="{StaticResource SkCombo}" Width="120"/>
                    <TextBlock Text="Putar (°)" VerticalAlignment="Center" Foreground="{StaticResource SkText2}" Margin="16,0,8,0"/>
                    <TextBox x:Name="RollBox" Style="{StaticResource SkField}" Width="60"/>
                    <TextBlock Text="Tampak 2D" VerticalAlignment="Center" Foreground="{StaticResource SkText2}" Margin="16,0,8,0"/>
                    <ComboBox x:Name="ViewBox" Style="{StaticResource SkCombo}" Width="150"/>
                    <CheckBox x:Name="HatchBox" Style="{StaticResource SkSwitch}" Content="Arsir" Margin="18,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="DimsBox" Style="{StaticResource SkSwitch}" Content="Dimensi" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Style="{StaticResource SkGhost}" Content="Tabel satu jenis" Click="OnTableFamily" Margin="0,0,8,0" Padding="12,8"/>
                    <Button Style="{StaticResource SkGhost}" Content="Tabel properti" Click="OnTable" Margin="0,0,8,0" Padding="12,8"/>
                    <Button Style="{StaticResource SkGhost}" Content="Penampang" Click="OnSectionDraw" Margin="0,0,8,0" Padding="12,8"/>
                    <Button Style="{StaticResource SkGhost}" Content="Batang 2D" Click="On2D" Margin="0,0,8,0" Padding="12,8"/>
                    <Button Style="{StaticResource SkPrimary}" Click="On3D" MinWidth="150">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FB;" FontFamily="{StaticResource SkIcons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Batang 3D"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Row="1" x:Name="Status" FontSize="11.5" Margin="0,10,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"/>
            </Grid>
        </Grid>
    </Border>
</Window>
