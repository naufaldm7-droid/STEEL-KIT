<Window x:Class="SteelKit.Acad.Ui.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SteelKit.Acad.Ui"
        Title="Steel Kit - Asisten" Width="1240" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="{DynamicResource SkFont}" Foreground="{DynamicResource SkText}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="/SteelKit;component/Ui/Theme.xaml"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root">
        <Grid Margin="18,0,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- judul -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource SkLogo}" Width="26" Height="26"/>
                    <TextBlock Text="STEEL KIT" FontFamily="{StaticResource SkFontDisplay}" FontWeight="Bold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="#33FFFFFF" Margin="12,0"/>
                    <TextBlock Text="Asisten" FontSize="14" Foreground="{StaticResource SkText2}" VerticalAlignment="Center"/>
                    <Border CornerRadius="8" Background="#1F38BDF8" BorderBrush="#5538BDF8" BorderThickness="1" Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="offline · bahasa Indonesia" FontSize="11" Foreground="#9BDCFB"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,-10,0">
                    <Button Style="{StaticResource SkWinBtn}" Content="&#xE921;" Click="OnMin" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource SkWinBtn}" Content="&#xE922;" Click="OnMax" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource SkWinBtn}" Content="&#xE8BB;" Click="OnCancel" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- masukan: mikrofon + kalimat -->
            <Border Grid.Row="1" Style="{StaticResource SkCard}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- tombol mikrofon bulat dengan cincin level suara -->
                    <Grid Grid.Column="0" Grid.Row="0" Width="84" Height="84" Margin="0,0,16,0" VerticalAlignment="Top">
                        <Ellipse x:Name="MicRing" Width="64" Height="64" Fill="{StaticResource SkGrad}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="MicRingScale" ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Button x:Name="MicButton" Width="64" Height="64" Click="OnMic" Cursor="Hand" ToolTip="Klik lalu bicara. Berhenti otomatis saat Anda diam. Klik lagi untuk berhenti.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="bg" Fill="{StaticResource SkGrad}">
                                            <Ellipse.Effect><DropShadowEffect Color="#38BDF8" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/></Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse Margin="2,2,2,30" Fill="#26FFFFFF"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Fill" Value="{StaticResource SkGradHover}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="MicGlyph" Text="&#xE720;" FontFamily="{StaticResource SkIcons}" FontSize="24" Foreground="White"/>
                        </Button>
                    </Grid>

                    <Button x:Name="MicPick" Grid.Column="0" Grid.Row="1" Margin="0,10,16,0" VerticalAlignment="Top" HorizontalAlignment="Center" Cursor="Hand" Click="OnMicPick"
                            ToolTip="Pilih mikrofon. Otomatis = mikrofon fisik yang menerima suara (mikrofon virtual seperti iVCam/OBS dilewati).">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="8" Padding="6,3" Background="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MicPickText" Text="Otomatis" FontSize="10.5" Foreground="#9FB0C2" MaxWidth="70" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="7" Foreground="#9FB0C2" Margin="4,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#18FFFFFF"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Grid Grid.Column="1" Grid.Row="0">
                        <TextBox x:Name="Input" Style="{StaticResource SkTextBox}" Height="84" TextWrapping="Wrap" AcceptsReturn="False"
                                 VerticalContentAlignment="Top" PreviewKeyDown="OnInputKey" TextChanged="OnInputChanged"/>
                        <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="14,11,14,0" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource SkText3}"
                                   Text="Ceritakan struktur yang Anda mau, mis. &quot;gudang bentang 20 meter tinggi 6 meter, 5 bay jarak 6 meter, kolom WF400, gording C150 jarak 1,2 meter&quot;"/>
                    </Grid>

                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="14,0,0,0" VerticalAlignment="Top">
                        <Button Style="{StaticResource SkPrimary}" Click="OnParse" MinWidth="150" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource SkIcons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Baca maksud"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="atau Enter" FontSize="11" Foreground="{StaticResource SkText3}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- status suara / unduh model -->
                    <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="VoiceStatus" FontSize="12.5" Foreground="{StaticResource SkText2}" TextWrapping="Wrap"
                                       Text="Klik mikrofon lalu bicara dalam bahasa Indonesia sehari-hari; berhenti otomatis saat Anda diam. Suara diproses di komputer ini, tidak dikirim ke internet."/>
                            <ProgressBar x:Name="VoiceProgress" Style="{StaticResource SkProgress}" Maximum="100" Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Top">
                            <Button x:Name="DownloadButton" Style="{StaticResource SkGhost}" Content="Unduh model suara" Padding="12,5" FontSize="12" Click="OnDownload" Visibility="Collapsed"/>
                            <Button x:Name="FolderButton" Style="{StaticResource SkGhost}" Content="Buka folder" Padding="12,5" FontSize="12" Margin="6,0,0,0" Click="OnOpenFolder" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- contoh kalimat -->
                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="CONTOH" Style="{StaticResource SkLabel}" FontSize="10"/>
                        <WrapPanel x:Name="Chips"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- hasil: ringkasan, asumsi, tabel | pratinjau -->
            <Grid Grid.Row="2" Margin="0,14,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.75*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource SkCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="16,14,16,6">
                            <TextBlock Text="USULAN" Style="{StaticResource SkLabel}" FontSize="10"/>
                            <TextBlock x:Name="Summary" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" Text="Belum ada kalimat."/>
                        </StackPanel>
                        <Border Grid.Row="1" Margin="16,6,16,10" CornerRadius="9" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="ASUMSI &amp; YANG PERLU DIPERIKSA" Style="{StaticResource SkLabel}" FontSize="10" Margin="0,0,0,4"/>
                                <ItemsControl x:Name="Notes" MaxHeight="96">
                                    <ItemsControl.Template>
                                        <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource SkIcons}" FontSize="11" Foreground="{Binding IconBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5" Foreground="{StaticResource SkText2}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="MemberGrid" Grid.Row="2" Style="{StaticResource SkGrid}" Margin="8,0,8,8" CellEditEnding="OnCellEdit">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Pasang" Width="58">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><CheckBox Style="{StaticResource SkCheck}" IsChecked="{Binding On, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Jenis" Width="92" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding RoleBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Role}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Profil" Binding="{Binding Profile}" Width="138" EditingElementStyle="{StaticResource SkGridEdit}"/>
                                <DataGridTextColumn Header="Panjang" Binding="{Binding Length}" Width="62" IsReadOnly="True"/>
                                <DataGridTextColumn Header="X1" Binding="{Binding X1}" Width="*" MinWidth="50" EditingElementStyle="{StaticResource SkGridEdit}"/>
                                <DataGridTextColumn Header="Y1" Binding="{Binding Y1}" Width="*" MinWidth="50" EditingElementStyle="{StaticResource SkGridEdit}"/>
                                <DataGridTextColumn Header="Z1" Binding="{Binding Z1}" Width="*" MinWidth="50" EditingElementStyle="{StaticResource SkGridEdit}"/>
                                <DataGridTextColumn Header="X2" Binding="{Binding X2}" Width="*" MinWidth="50" EditingElementStyle="{StaticResource SkGridEdit}"/>
                                <DataGridTextColumn Header="Y2" Binding="{Binding Y2}" Width="*" MinWidth="50" EditingElementStyle="{StaticResource SkGridEdit}"/>
                                <DataGridTextColumn Header="Z2" Binding="{Binding Z2}" Width="*" MinWidth="50" EditingElementStyle="{StaticResource SkGridEdit}"/>
                                <DataGridTextColumn Header="Putar" Binding="{Binding Roll}" Width="46" EditingElementStyle="{StaticResource SkGridEdit}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="GridEmpty" Grid.Row="2" Text="Daftar batang muncul di sini setelah kalimat dibaca. Semua sel bisa diedit."
                                   Foreground="{StaticResource SkText3}" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SkCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="16,14,16,4">
                            <TextBlock Text="PRATINJAU 3D" Style="{StaticResource SkLabel}" FontSize="10"/>
                            <TextBlock Text="seret untuk memutar · gulir untuk zoom" FontSize="10.5" Foreground="{StaticResource SkText3}" HorizontalAlignment="Right"/>
                        </Grid>
                        <UniformGrid x:Name="Stats" Grid.Row="0" Columns="3" Margin="16,34,16,0" VerticalAlignment="Top"/>
                        <ui:IsoView x:Name="Preview" Grid.Row="1" Margin="8,8,8,8"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- aksi -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="AutoConnectBox" Style="{StaticResource SkSwitch}" IsChecked="True" Content="Langsung buat sambungan otomatis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Margin="22,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SkText3}" TextWrapping="Wrap"
                           Text="Ukuran profil adalah masukan engineer. Kapasitas batang dan sambungan tetap dihitung engineer struktur."/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SkGhost}" Content="Batal" Click="OnCancel" MinWidth="96" Margin="0,0,10,0"/>
                    <Button x:Name="PlaceButton" Style="{StaticResource SkPrimary}" Click="OnPlace" MinWidth="170" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FB;" FontFamily="{StaticResource SkIcons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="PlaceText" Text="Pasang di gambar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
