<Window x:Class="SteelKit.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steel Kit - Pasang" Width="620" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="{DynamicResource SkFont}" Foreground="{DynamicResource SkText}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="/SteelKitSetup;component/Ui/Theme.xaml"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root">
        <Grid Margin="28,0,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button Style="{StaticResource SkWinBtn}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,-20,0" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                <Image Source="{StaticResource SkLogo}" Width="64" Height="64">
                    <Image.Effect><DropShadowEffect Color="#38BDF8" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/></Image.Effect>
                </Image>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="STEEL KIT" FontFamily="{StaticResource SkFontDisplay}" FontWeight="Bold" FontSize="28"/>
                    <TextBlock x:Name="Sub" Text="Profil · sambungan · rangka untuk AutoCAD" FontSize="13.5" Foreground="{StaticResource SkText2}"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource SkCard}" Margin="0,22,0,18">
                <StackPanel>
                    <TextBlock x:Name="Heading" Text="AutoCAD yang ditemukan" Style="{StaticResource SkLabel}"/>
                    <ItemsControl x:Name="Versions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource SkIcons}" FontSize="13" Foreground="{Binding Brush}" Margin="0,2,10,0"/>
                                    <TextBlock Text="{Binding Text}" FontSize="13.5"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="Message" Margin="0,14,0,0" FontSize="12.5" Foreground="{StaticResource SkText2}" TextWrapping="Wrap"
                               Text="Dipasang untuk akun Windows ini saja, tanpa hak admin. Setelah selesai, buka AutoCAD lalu pilih tab ribbon Steel Kit."/>
                    <CheckBox x:Name="VoiceBox" Style="{StaticResource SkSwitch}" IsChecked="True" Margin="0,14,0,0" FontSize="12.5"
                              Content="Sekalian pasang suara offline (unduh model ±181 MB sekali)"/>
                    <ProgressBar x:Name="Progress" Style="{StaticResource SkProgress}" Maximum="100" Margin="0,14,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3">
                <TextBlock x:Name="Footer" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SkText3}" Text="v0.1.0 · gratis · MIT · @nrozan"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RemoveButton" Style="{StaticResource SkGhost}" Content="Lepas" MinWidth="90" Margin="0,0,10,0" Click="OnRemove" Visibility="Collapsed"/>
                    <Button x:Name="MainButton" Style="{StaticResource SkPrimary}" MinWidth="160" Height="42" Click="OnMain">
                        <TextBlock x:Name="MainText" Text="Pasang"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
